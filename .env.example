# Vite inlines every VITE_-prefixed variable into the shipped JavaScript bundle.
# Only values that are safe to hand to any visitor belong here.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. It is a backend-only
# secret and must never appear in this file, in any VITE_ variable, or anywhere
# else in this repository.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL="MY_SUPABASE_URL"

# The anon (publishable) key. Safe to ship: it grants only what row-level
# security and Supabase Auth allow an anonymous caller to do.
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Base URL of the Rally backend, including the version prefix.
VITE_API_BASE_URL="http://localhost:4000/api/v1"
